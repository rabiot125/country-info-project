{
  "info": {
    "name": "Country Info Service",
    "description": "Covers every endpoint and the main error cases. Run the folders in order (Happy path first). Set baseUrl to http://localhost:8080 (compose / port-forward) or http://country-info.local (ingress).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "countryId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Happy path",
      "item": [
        {
          "name": "Create country (kenya)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "postman-{{$timestamp}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/countries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "countries"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"kenya\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json(); pm.collectionVariables.set('countryId', b.id);",
                  "pm.test('ISO KE', () => pm.expect(b.isoCode).to.eql('KE'));",
                  "pm.test('capital Nairobi', () => pm.expect(b.capitalCity).to.eql('Nairobi'));",
                  "pm.test('Location header', () => pm.response.to.have.header('Location'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create multi-word country (south africa)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "postman-{{$timestamp}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/countries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "countries"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"  south   africa \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 or 409', () => pm.expect(pm.response.code).to.be.oneOf([201,409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "List countries (paged)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "postman-{{$timestamp}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/countries?page=0&size=10&sort=name,asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "countries"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "name,asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get country by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "postman-{{$timestamp}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/countries/{{countryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "countries",
                "{{countryId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update country",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "postman-{{$timestamp}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/countries/{{countryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "countries",
                "{{countryId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kenya\",\n  \"capitalCity\": \"Nairobi\",\n  \"phoneCode\": \"254\",\n  \"continentCode\": \"AF\",\n  \"currencyIsoCode\": \"KES\",\n  \"flagUrl\": \"http://www.oorsprong.org/WebSamples.CountryInfo/Flags/Kenya.jpg\",\n  \"languages\": [\n    {\n      \"isoCode\": \"sw\",\n      \"name\": \"Swahili\"\n    },\n    {\n      \"isoCode\": \"en\",\n      \"name\": \"English\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
